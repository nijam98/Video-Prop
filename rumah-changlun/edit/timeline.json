{
 "duration": 77.9333,
 "segments": [
  {
   "id": "hook-a",
   "src_in": 103.86666666666666,
   "src_out": 106.83333333333333,
   "out_in": 0.0,
   "out_out": 2.9667,
   "text": "Rumah full reno macam ni, daripada depan sampai belakang."
  },
  {
   "id": "hook-b",
   "src_in": 91.73333333333333,
   "src_out": 95.3,
   "out_in": 2.9667,
   "out_out": 6.5333,
   "text": "Pasal rumah ni kita nak lepas. Habis murah, bawah market value."
  },
  {
   "id": "tamu-1",
   "src_in": 0.0,
   "src_out": 6.5,
   "out_in": 6.5333,
   "out_out": 13.0333,
   "text": "Sekarang ni kita duduk-duduk kat ruang tamu. Nampak ruang tamu siap dengan siling plaster, ada skirting, ada lampu, siap kipas."
  },
  {
   "id": "tamu-2",
   "src_in": 6.6,
   "src_out": 7.833333333333333,
   "out_in": 13.0333,
   "out_out": 14.2667,
   "text": "Barang ni akan tinggal."
  },
  {
   "id": "tamu-3",
   "src_in": 9.333333333333334,
   "src_out": 14.266666666666667,
   "out_in": 14.2667,
   "out_out": 19.2,
   "text": "Cuma pinggan mangkuk ni ambil lah. Sebab pinggan mangkuk ni lagi mahal daripada almari ni."
  },
  {
   "id": "master-1",
   "src_in": 14.333333333333334,
   "src_out": 16.633333333333333,
   "out_in": 19.2,
   "out_out": 21.5,
   "text": "Okey, kita tengok di bilik ni, master bedroom."
  },
  {
   "id": "master-2",
   "src_in": 17.266666666666666,
   "src_out": 24.3,
   "out_in": 21.5,
   "out_out": 28.5333,
   "text": "Master bedroom ni boleh memakai katil king ataupun super king pun lepas. Ataupun queen pun lepas. Built-in satu."
  },
  {
   "id": "master-3",
   "src_in": 25.666666666666668,
   "src_out": 28.766666666666666,
   "out_in": 28.5333,
   "out_out": 31.6333,
   "text": "Satu tandas yang cantik. Okey, almari pun akan tinggal."
  },
  {
   "id": "master-4",
   "src_in": 29.933333333333334,
   "src_out": 31.1,
   "out_in": 31.6333,
   "out_out": 32.8,
   "text": "Kalau anda nak katil, beritahu."
  },
  {
   "id": "util-1",
   "src_in": 32.36666666666667,
   "src_out": 34.36666666666667,
   "out_in": 32.8,
   "out_out": 34.8,
   "text": "Sebelah sini kita ada utility."
  },
  {
   "id": "util-2",
   "src_in": 35.1,
   "src_out": 39.3,
   "out_in": 34.8,
   "out_out": 39.0,
   "text": "Utility pun just nice. Boleh buat store. Ada satu loteng siap."
  },
  {
   "id": "bilik2-1",
   "src_in": 39.733333333333334,
   "src_out": 41.733333333333334,
   "out_in": 39.0,
   "out_out": 41.0,
   "text": "Okey, ni bilik yang kedua pun cantik."
  },
  {
   "id": "bilik2-2",
   "src_in": 43.266666666666666,
   "src_out": 47.4,
   "out_in": 41.0,
   "out_out": 45.1333,
   "text": "Ada ruang untuk pengudaraan dan pencahayaan."
  },
  {
   "id": "makan-1",
   "src_in": 47.63333333333333,
   "src_out": 51.86666666666667,
   "out_in": 45.1333,
   "out_out": 49.3667,
   "text": "Okey, kita tengok di ruang makan, ruang dapur. Yang ni paling spesial, paling cantik."
  },
  {
   "id": "makan-2",
   "src_in": 52.1,
   "src_out": 53.266666666666666,
   "out_in": 49.3667,
   "out_out": 50.5333,
   "text": "Siap dengan partition."
  },
  {
   "id": "makan-3",
   "src_in": 54.266666666666666,
   "src_out": 55.43333333333333,
   "out_in": 50.5333,
   "out_out": 51.7,
   "text": "Okey, meja makan."
  },
  {
   "id": "makan-4",
   "src_in": 56.13333333333333,
   "src_out": 57.233333333333334,
   "out_in": 51.7,
   "out_out": 52.8,
   "text": "Owner tinggal."
  },
  {
   "id": "bilik3-1",
   "src_in": 59.666666666666664,
   "src_out": 61.86666666666667,
   "out_in": 52.8,
   "out_out": 55.0,
   "text": "Haa, ni kita tengok ni, ruang bilik nombor tiga."
  },
  {
   "id": "bilik3-2",
   "src_in": 62.8,
   "src_out": 65.83333333333333,
   "out_in": 55.0,
   "out_out": 58.0333,
   "text": "Haa, bilik nombor tiga boleh memakai bilik bujang. Katil single."
  },
  {
   "id": "toilet2",
   "src_in": 66.36666666666666,
   "src_out": 67.93333333333334,
   "out_in": 58.0333,
   "out_out": 59.6,
   "text": "Toilet yang kedua."
  },
  {
   "id": "dapur",
   "src_in": 70.46666666666667,
   "src_out": 75.83333333333333,
   "out_in": 59.6,
   "out_out": 64.9667,
   "text": "Haa, ruang dapur. Siap extend sampai ke belakang. Dapat kitchen cabinet full daripada bawah sampai ke atas."
  },
  {
   "id": "laundry",
   "src_in": 83.33333333333333,
   "src_out": 87.2,
   "out_in": 64.9667,
   "out_out": 68.8333,
   "text": "Lepas tu, yang ni ruang laundry. Okey, belakang. Siap dengan extend."
  },
  {
   "id": "cta-1",
   "src_in": 97.53333333333333,
   "src_out": 101.86666666666666,
   "out_in": 68.8333,
   "out_out": 73.1667,
   "text": "Loan LPPSA boleh, loan bank boleh. Yang mana berniaga, perlu SSM dan statement bank 6 bulan."
  },
  {
   "id": "cta-2",
   "src_in": 96.3,
   "src_out": 97.5,
   "out_in": 73.1667,
   "out_out": 74.3667,
   "text": "Cepat, jangan lepaskan peluang."
  },
  {
   "id": "cta-3",
   "src_in": 106.83333333333333,
   "src_out": 110.4,
   "out_in": 74.3667,
   "out_out": 77.9333,
   "text": "Taman Jelutong, Changlun. Roger sahaja. Bye bye."
  }
 ],
