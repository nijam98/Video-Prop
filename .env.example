# Salin fail ini kepada .env dan isi nilai anda. JANGAN commit .env ke GitHub.

# ---------- Facebook Page ----------
FB_ENABLED=true
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
FB_GRAPH_VERSION=v23.0
# true = link affiliate diletak dalam komen pertama (kapsyen lebih bersih, kurang risiko reach jatuh)
FB_LINK_IN_COMMENT=true

# ---------- Threads ----------
THREADS_ENABLED=true
THREADS_USER_ID=me
THREADS_ACCESS_TOKEN=
# true = link diletak dalam reply, bukan dalam pos utama
THREADS_LINK_IN_REPLY=false
THREADS_MAX_HASHTAGS=1

# ---------- Shopee Affiliate Open API (PILIHAN) ----------
# Jika diisi: boleh import produk ikut kata kunci + jana short link dengan sub_id (facebook/threads)
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=
SHOPEE_API_URL=https://open-api.affiliate.shopee.com.my/graphql

# ---------- Jadual ----------
TIMEZONE=Asia/Kuala_Lumpur
POST_TIMES=09:00,13:00,20:00
REPOST_COOLDOWN_DAYS=7

# ---------- Fail ----------
PRODUCTS_FILE=data/products.csv
TEMPLATES_FILE=data/templates.json
STATE_FILE=data/state.json

# true = uji sahaja, tiada pos sebenar
DRY_RUN=false
